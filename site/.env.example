# Copy these into Railway's Variables tab — do not commit a real .env file.

# 'sandbox' while testing, 'production' once you go live
PESAPAL_ENV=sandbox

PESAPAL_CONSUMER_KEY=your_consumer_key
PESAPAL_CONSUMER_SECRET=your_consumer_secret

# Currency to charge. Confirm with Pesapal which currencies your merchant
# account is approved for — KES is the safest default for a Kenyan account.
PESAPAL_CURRENCY=USD

# Filled in AFTER you deploy and call /api/register-ipn once (see README)
PESAPAL_NOTIFICATION_ID=

# The public URL Railway gives your deployed service, e.g. https://atomic-shelf-payments.up.railway.app
APP_BASE_URL=

# A password of your choosing, only used to protect /api/register-ipn from strangers
SETUP_KEY=choose-a-long-random-string

# Restrict which site can call this API. Use https://atomic-shelf.com once live.
ALLOWED_ORIGIN=*

# Transactional customer email. Keep these server-side in Railway.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Atomic Shelf

# Optional NYT Books bestseller feed for Readers. Keep this server-side.
NYT_BOOKS_API_KEY=
NYT_BOOKS_LIST=hardcover-fiction

# --- Payment persistence (Phase 2) ---
# Default store is file-backed (JSON under private-data/); no extra config needed.
# To switch to PostgreSQL, set both variables:
#
#   PAYMENT_STORE=postgres
#   DATABASE_URL=postgresql://user:password@host:5432/dbname
#
# The store is auto-selected: if DATABASE_URL is present, postgres is used
# automatically; set PAYMENT_STORE=file to override back to the file adapter.
#
# SSL is inferred from the host: localhost/127.0.0.1 → no SSL, everything else
# → { rejectUnauthorized: false }. Override with DATABASE_SSL=false or
# DATABASE_SSL=true if your provider requires a specific setting.
PAYMENT_STORE=
DATABASE_URL=
DATABASE_SSL=
