# Copy these into Railway's Variables tab — do not commit a real .env file.

# 'sandbox' while testing, 'production' once you go live
PESAPAL_ENV=sandbox

PESAPAL_CONSUMER_KEY=your_consumer_key
PESAPAL_CONSUMER_SECRET=your_consumer_secret

# Currency to charge. Confirm with Pesapal which currencies your merchant
# account is approved for — KES is the safest default for a Kenyan account.
PESAPAL_CURRENCY=USD

# Filled in AFTER you deploy and call /api/register-ipn once (see README)
PESAPAL_NOTIFICATION_ID=

# The public URL Railway gives your deployed service, e.g. https://atomic-shelf-payments.up.railway.app
APP_BASE_URL=

# A password of your choosing, only used to protect /api/register-ipn from strangers
SETUP_KEY=choose-a-long-random-string

# Restrict which site can call this API. Use https://atomic-shelf.com once live.
ALLOWED_ORIGIN=*
